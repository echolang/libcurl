/**
 * A client, and the free `send` for when one isn't worth naming.
 *
 * **A `Client` is a connection, not a namespace.** It holds one libcurl handle, which is what
 * keeps the TCP connection, the DNS answer, and the TLS session alive between requests. That's
 * the whole reason to use libcurl instead of a socket.
 *
 * Everything else it holds is defaults: a base URL, headers, and the same `Opt` list a
 * `Request` carries. `send` writes library defaults, then `$opts`, then the request's list.
 * There is no second bag of fields to keep in sync with `Request`.
 *
 * It's a class because it has identity, not contents. Two names for one client are two names
 * for one connection, which is what you want. As a struct it would silently copy the handle.
 *
 * `send` is the only verb here, matching `Request`. One way in. The shorthand does the rest.
 */

namespace curl;

public class Client
{
    private Easy $easy;

    public Headers $headers;
    public string $baseUrl;
    public array<Opt> $opts;

    constructor()
    {
        $this->easy = Easy();
        $this->headers = Headers();
        $this->baseUrl = '';
        $this->opts = array<Opt>();
    }

    /**
     * False when libcurl wouldn't give us a handle. Every `send` then fails with the reason.
     */
    function open() : bool
    {
        return $this->easy->open();
    }

    /**
     * A header every request carries, unless the request sets one of the same name itself.
     */
    function header(const string& $name, const string& $value) : void
    {
        $this->headers->set($name, $value);
    }

    function set(LongOption $option, int64 $value) : void
    {
        pushLong($this->opts, $option, $value);
    }

    function set(StringOption $option, const string& $value) : void
    {
        pushStr($this->opts, $option, $value);
    }

    function set(OffOption $option, int64 $value) : void
    {
        pushOff($this->opts, $option, $value);
    }

    /**
     * An option this library hasn't named, by number. Replayed after every reset.
     *
     * Don't mutate a live handle and then call `send`: `send` resets the handle, which is
     * what stops one request leaking into the next. Drive an `Easy` yourself if you want
     * the `CURL*` with no `send` in between.
     */
    function raw(int32 $option, int64 $value) : void
    {
        pushRawLong($this->opts, $option, $value);
    }

    function raw(int32 $option, const string& $value) : void
    {
        pushRawStr($this->opts, $option, $value);
    }

    function timeout(int32 $ms) : void
    {
        int64 $wide = $ms;

        pushLong($this->opts, .timeoutMs, $wide);
    }

    function connectTimeout(int32 $ms) : void
    {
        int64 $wide = $ms;

        pushLong($this->opts, .connectTimeoutMs, $wide);
    }

    function follow(bool $on) : void
    {
        if ($on) {
            pushLong($this->opts, .followRedirects, 1);
        }
        else {
            pushLong($this->opts, .followRedirects, 0);
        }
    }

    function maxRedirects(int32 $n) : void
    {
        int64 $wide = $n;

        pushLong($this->opts, .maxRedirects, $wide);
    }

    function verifyTls(bool $on) : void
    {
        pushVerifyTls($this->opts, $on);
    }

    function userAgent(const string& $agent) : void
    {
        pushStr($this->opts, .userAgent, $agent);
    }

    function caFile(const string& $path) : void
    {
        pushStr($this->opts, .caInfo, $path);
    }

    function acceptEncoding(bool $on) : void
    {
        pushAcceptEncoding($this->opts, $on);
    }

    function auth(const string& $username, const string& $password) : void
    {
        pushAuth($this->opts, $username, $password);
    }

    function proxy(const string& $url) : void
    {
        pushStr($this->opts, .proxy, $url);
    }

    /**
     * Runs a request on this client's connection.
     *
     * Options go on in a fixed order: library defaults, then this client's list, then the
     * request's. libcurl is last-write-wins, so a later `Opt` always beats an earlier one.
     */
    function send(const Request& $request) : result<Response, Error>
    {
        if (!$this->easy->open()) {
            return .error(Error::failedInit('libcurl would not open a handle'));
        }

        // reset keeps the connection and drops every option, so one request can't leak
        // settings into the next. that's the classic keep-alive bug. the stacked list is
        // replayed after, which is what makes `$api->timeout(...)` a real default
        $this->easy->reset();

        Request $ready = prepare($this, $request);
        array<Opt> $opts = stackOpts($this->opts, $request->opts);

        return perform($this->easy, $ready, $opts);
    }
}

/**
 * Runs one request on a handle of its own.
 *
 * The spelling for a script, or for a request that has nothing to reuse. It differs from
 * `Client::send` in exactly one way: no connection is kept afterwards. That's the one thing
 * a `Client` is for. Both take the same `Request`, so moving between them changes the
 * receiver and nothing else.
 *
 * An `Easy`, not a `Client`. A class is a heap object, and a one-shot request doesn't need one.
 */
public function send(const Request& $request) : result<Response, Error>
{
    Easy $once = Easy();

    if (!$once->open()) {
        return .error(Error::failedInit('libcurl would not open a handle'));
    }

    Request $ready = prepare($request);
    array<Opt> $empty = array<Opt>();
    array<Opt> $opts = stackOpts($empty, $request->opts);

    return perform($once, $ready, $opts);
}

/**
 * What libcurl this program actually picked up.
 */
public function version() : string
{
    return str::from(cVersion());
}
