/**
 * What can be read back off a handle after a transfer. Backed enums, one per C result type.
 *
 * Same split as `opt.eco`, and for the same reason: `curl_easy_getinfo` writes through the
 * pointer it's handed, so asking a `CURLINFO_STRING` for a `long` writes an address into
 * a long-sized integer slot and answers nonsense.
 *
 * Read through `Easy::infoLong` / `infoString` / `infoDouble`, named per family rather
 * than overloaded. An info has only the one argument, so a leading-dot shorthand would
 * have nothing to disambiguate against, and a return type isn't part of a signature.
 */

namespace curl;

/**
 * Infos answering a C `long`.
 */
public enum LongInfo : int32
{
    /**
     * The HTTP status, and what `Response::status` reads. `CURLINFO_RESPONSE_CODE`.
     */
    case responseCode = 2097154;

    /**
     * How many redirects were followed. `Response::redirects`. `CURLINFO_REDIRECT_COUNT`.
     */
    case redirectCount = 2097172;

    /**
     * The port the final hop connected to. `Response::port`. `CURLINFO_PRIMARY_PORT`.
     */
    case primaryPort = 2097192;

    /**
     * The HTTP version the final hop spoke, as the number `HttpVersion::from` takes.
     * `CURLINFO_HTTP_VERSION`.
     */
    case httpVersion = 2097198;

}

/**
 * Infos answering a C string. Every one may legitimately answer nothing, which is why
 * `Easy::infoString` hands back a `string?`.
 */
public enum StringInfo : int32
{
    /**
     * Where the transfer ended up. `Response::url`. `CURLINFO_EFFECTIVE_URL`.
     */
    case effectiveUrl = 1048577;

    /**
     * The response's `Content-Type`, or nothing. `CURLINFO_CONTENT_TYPE`.
     */
    case contentType = 1048594;

    /**
     * Where a redirect would have gone, when `follow` was off. `CURLINFO_REDIRECT_URL`.
     */
    case redirectUrl = 1048607;

    /**
     * The address the final hop connected to. `Response::ip`. `CURLINFO_PRIMARY_IP`.
     */
    case primaryIp = 1048608;

    /**
     * The scheme of the final hop's URL. `CURLINFO_SCHEME`.
     */
    case scheme = 1048625;

}

/**
 * Infos answering a C `double`, all of them seconds since the transfer started.
 */
public enum DoubleInfo : int32
{
    /**
     * The whole transfer. `Response::seconds`. `CURLINFO_TOTAL_TIME`.
     */
    case totalTime = 3145731;

    /**
     * Name resolved. `Timings::dns`. `CURLINFO_NAMELOOKUP_TIME`.
     */
    case nameLookupTime = 3145732;

    /**
     * TCP connected. `Timings::connect`. `CURLINFO_CONNECT_TIME`.
     */
    case connectTime = 3145733;

    /**
     * About to send. `Timings::sent`. `CURLINFO_PRETRANSFER_TIME`.
     */
    case preTransferTime = 3145734;

    /**
     * First byte arrived. `Timings::firstByte`. `CURLINFO_STARTTRANSFER_TIME`.
     */
    case startTransferTime = 3145745;

    /**
     * Spent on redirects. `Timings::redirect`. `CURLINFO_REDIRECT_TIME`.
     */
    case redirectTime = 3145747;

    /**
     * TLS handshake done. `Timings::tls`. `CURLINFO_APPCONNECT_TIME`.
     */
    case appConnectTime = 3145761;

}
