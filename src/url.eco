/**
 * The three URL questions this library actually asks.
 *
 * There is no URL type. Echo has no path type either (a path is a string), and inventing
 * one here would be a bigger design than the client. What we need is smaller: is this
 * absolute, how does it join a base (including an origin-relative `/path`), and where
 * do query pairs go when a fragment is already on the string.
 *
 * Written as predicates over bytes, not a parse-then-print. The only bug these exist to
 * close is the one `contains('://')` / `contains('?')` would keep opening.
 */

namespace curl;

/**
 * True when `$url` begins with a scheme, `https://...`.
 *
 * `://` has to appear *before* any of `/`, `?`, `#`. A relative path with an absolute URL
 * in its query (`redirect?url=https://evil.com`) is not absolute, and gluing it onto a
 * base is what the caller asked for.
 */
internal function isAbsoluteUrl(const string& $url) : bool
{
    usize $scheme = $url->find('://');

    if ($scheme >= $url->size()) {
        return false;
    }

    usize $i = 0;

    while ($i < $scheme) {
        uint8 $b = $url->byte($i);

        if ($b == CH_SLASH || $b == CH_QUESTION || $b == CH_HASH) {
            return false;
        }

        $i = $i + 1;
    }

    return true;
}

/**
 * Index where the authority ends: the first `/`, `?`, or `#` after `scheme://`,
 * or the end of the string. No `://` means the whole string is not an origin.
 */
internal function authorityEnd(const string& $url) : usize
{
    usize $scheme = $url->find('://');

    if ($scheme >= $url->size()) {
        return $url->size();
    }

    usize $i = $scheme + 3;
    usize $size = $url->size();

    while ($i < $size) {
        uint8 $b = $url->byte($i);

        if ($b == CH_SLASH || $b == CH_QUESTION || $b == CH_HASH) {
            return $i;
        }

        $i = $i + 1;
    }

    return $size;
}

/**
 * `$base` and `$url`, joined.
 *
 * An absolute URL wins. A protocol-relative one (`//cdn.example.com/x`) takes the base's
 * scheme and nothing else of it. A path that starts with `/` replaces everything after
 * the authority, the way a browser does: `https://api.example.com/v1` + `/health` is
 * `https://api.example.com/health`, not `.../v1/health`. A `?query` or `#fragment` replaces
 * the base's own. Anything else is glued onto the base's path with exactly one slash, so a
 * query on the base (`.../v1?key=1`) never ends up in front of it. An empty base is a
 * no-op, and so is an empty url: it means the base itself, with no slash added.
 */
internal function joinUrl(const string& $base, const string& $url) : string
{
    if ($base->empty()) {
        return $url;
    }

    if ($url->empty()) {
        return $base;
    }

    if (isAbsoluteUrl($url)) {
        return $url;
    }

    if ($url->starts('//')) {
        usize $scheme = $base->find('://');

        if ($scheme >= $base->size()) {
            return $url;
        }

        string $prefix = $base->sub(0, $scheme + 3);
        string $rest = $url->sub(2, $url->size() - 2);

        return $prefix->concat($rest);
    }

    if ($url->starts('/')) {
        usize $end = authorityEnd($base);

        return $base->sub(0, $end)->concat($url);
    }

    if ($url->starts('#')) {
        return $base->sub(0, $base->find('#'))->concat($url);
    }

    string $path = $base->sub(0, pathEnd($base));

    if ($url->starts('?')) {
        return $path->concat($url);
    }

    if ($path->ends('/')) {
        return $path->concat($url);
    }

    return "{$path}/{$url}";
}

/**
 * Index where the path ends: the first `?` or `#`, or the end of the string.
 */
internal function pathEnd(const string& $url) : usize
{
    usize $query = $url->find('?');
    usize $fragment = $url->find('#');

    if ($fragment < $query) {
        return $fragment;
    }

    return $query;
}

/**
 * `$encoded` (`a=1&b=2`) appended as a query, without walking into a fragment.
 *
 * Split on the first `#`, decide `?` vs `&` on the head alone, put the fragment back.
 * That's the whole difference between this and `$url->contains('?')` plus an append,
 * which is how `https://example.com/page#section` used to become `...#section?a=1`.
 */
internal function appendQuery(const string& $url, const string& $encoded) : string
{
    if ($encoded->empty()) {
        return $url;
    }

    usize $hash = $url->find('#');
    string $head = $url;
    string $frag = '';

    if ($hash < $url->size()) {
        $head = $url->sub(0, $hash);
        $frag = $url->sub($hash, $url->size() - $hash);
    }

    string $out = $head;

    // a url that already ends in its separator (`/search?`) gets no second one
    if (!$head->contains('?')) {
        $out->append('?');
    }
    else if (!$head->ends('?') && !$head->ends('&')) {
        $out->append('&');
    }

    $out->append($encoded);
    $out->append($frag);

    return $out;
}

#[group: "unit"]
test an_empty_url_is_the_base_itself {
    assert(joinUrl('https://api.example.com/v1/users', '') == 'https://api.example.com/v1/users', 'no slash is added');
    assert(joinUrl('https://api.example.com/', '') == 'https://api.example.com/', 'a trailing one is kept');
    assert(joinUrl('', '') == '', 'nothing joined to nothing');
}

#[group: "unit"]
test a_relative_path_lands_before_the_base_query {
    assert(joinUrl('https://api.example.com/v1?key=abc', 'users') == 'https://api.example.com/v1/users', 'the path, not the query, is extended');
    assert(joinUrl('https://api.example.com/v1/#top', 'users') == 'https://api.example.com/v1/users', 'nor the fragment');
    assert(joinUrl('https://api.example.com/v1', 'users?page=2') == 'https://api.example.com/v1/users?page=2', 'the url keeps its own query');
}

#[group: "unit"]
test a_query_or_fragment_replaces_the_base_one {
    assert(joinUrl('https://api.example.com/v1?key=abc', '?page=2') == 'https://api.example.com/v1?page=2', 'a query replaces the query');
    assert(joinUrl('https://api.example.com/v1', '?page=2') == 'https://api.example.com/v1?page=2', 'or adds one, with no slash');
    assert(joinUrl('https://api.example.com/v1?k=1#a', '#b') == 'https://api.example.com/v1?k=1#b', 'a fragment replaces only the fragment');
}

#[group: "unit"]
test a_schemeless_base_still_joins {
    assert(joinUrl('localhost:8080', '/health') == 'localhost:8080/health', 'no scheme, so the whole base is the origin');
    assert(joinUrl('localhost:8080/v1', 'health') == 'localhost:8080/v1/health', 'and a relative path is glued on');
    assert(joinUrl('localhost:8080', '//cdn/x') == '//cdn/x', 'a protocol-relative url has no scheme to borrow');
}

#[group: "unit"]
test path_and_authority_ends {
    assert(pathEnd('https://a.example/x?q#f') == 19, 'the query comes first');
    assert(pathEnd('https://a.example/x#f?q') == 19, 'or the fragment does');
    assert(pathEnd('https://a.example/x') == 19, 'or neither, and it is the end');
    assert(authorityEnd('https://a.example') == 17, 'a bare origin ends at the end');
    assert(authorityEnd('https://a.example?q') == 17, 'a query ends the authority too');
    assert(authorityEnd('nothing') == 7, 'no scheme is no authority');
}

#[group: "unit"]
test append_query_does_not_double_a_separator {
    assert(appendQuery('https://e.com/s?', 'a=1') == 'https://e.com/s?a=1', 'a bare question mark');
    assert(appendQuery('https://e.com/s?x=1&', 'a=1') == 'https://e.com/s?x=1&a=1', 'a trailing ampersand');
    assert(appendQuery('https://e.com/s?#f', 'a=1') == 'https://e.com/s?a=1#f', 'and before a fragment');
    assert(appendQuery('https://e.com/s', '') == 'https://e.com/s', 'an empty query changes nothing');
}
