/**
 * Why a transfer didn't happen.
 *
 * An open integer enum, so `guard` / `match` is the call site:
 *
 *     guard curl::send(.get($url)) else ($e) {
 *         match ($e) {
 *             .timeout => { ... },
 *             else => { die("{$e}"); },
 *         }
 *     }
 *
 * Named cases are the CURLcodes this library publishes. `other` is a newer libcurl, or a
 * protocol we don't wrap. `from` always succeeds, and `value()` hands back the integer C
 * handed us, leftover or not. The sentence is libcurl's, read on demand by `message()`.
 *
 * The number on each case is curl's, frozen ABI, with the C name in its docblock so a line
 * can be checked against `curl.h` at a glance. This enum is the only place those numbers live.
 */

namespace curl;

#[docs::example: "examples/fileUrl.eco"]
#[docs::see: ["curl::send", "curl::Response"]]
/**
 * Why a transfer didn't happen.
 *
 * `send` answers `result<Response, Error>`, so a failure is a value you `guard` or `match`
 * on, never a `Response` with zeroes in it. A 404 is not an `Error`. The server answered,
 * and that answer is a `Response`.
 *
 * `message()` and `"{$e}"` are libcurl's own sentence for the code, and `value()` is the
 * CURLcode itself. `Error::from` always succeeds: a number this enum doesn't name is `other`.
 */
public enum Error : int32
{
    /**
     * The URL's scheme is one this libcurl wasn't built with. `CURLE_UNSUPPORTED_PROTOCOL`.
     */
    case unsupportedProtocol = 1;

    /**
     * libcurl wouldn't hand out a handle, so nothing was sent. `CURLE_FAILED_INIT`.
     */
    case failedInit = 2;

    /**
     * The URL couldn't be parsed. `CURLE_URL_MALFORMAT`.
     */
    case urlMalformat = 3;

    /**
     * The proxy's hostname didn't resolve. `CURLE_COULDNT_RESOLVE_PROXY`.
     */
    case couldNotResolveProxy = 5;

    /**
     * The hostname didn't resolve. Offline usually looks like this.
     * `CURLE_COULDNT_RESOLVE_HOST`.
     */
    case couldNotResolveHost = 6;

    /**
     * The host resolved, but nothing accepted the connection. `CURLE_COULDNT_CONNECT`.
     */
    case couldNotConnect = 7;

    /**
     * A status of 400 or above, but only after `set(.failOnError, 1)`. Without it, that status
     * is a `Response`. `CURLE_HTTP_RETURNED_ERROR`.
     */
    case httpReturnedError = 22;

    /**
     * The body couldn't be written: a `saveTo` path that can't be created or flushed.
     * `CURLE_WRITE_ERROR`.
     */
    case writeError = 23;

    /**
     * A file part of a `Form` couldn't be read. Caught before anything is sent.
     * `CURLE_READ_ERROR`.
     */
    case readError = 26;

    /**
     * libcurl ran out of memory, or couldn't grow a header list. `CURLE_OUT_OF_MEMORY`.
     */
    case outOfMemory = 27;

    /**
     * `timeout` or `connectTimeout` ran out. `CURLE_OPERATION_TIMEDOUT`.
     */
    case timeout = 28;

    /**
     * The TLS handshake failed. `CURLE_SSL_CONNECT_ERROR`.
     */
    case sslConnectError = 35;

    /**
     * A `file://` URL, or the file behind `uploadFile`, couldn't be read.
     * `CURLE_FILE_COULDNT_READ_FILE`.
     */
    case fileCouldNotReadFile = 37;

    /**
     * An `onProgress` or `onChunk` closure answered `false`. This is what cancelling looks
     * like. `CURLE_ABORTED_BY_CALLBACK`.
     */
    case abortedByCallback = 42;

    /**
     * The request contradicts itself: two bodies at once, a HEAD with a body, a header or form
     * part that can't go on the wire, a negative `maxBytes`. `CURLE_BAD_FUNCTION_ARGUMENT`.
     */
    case badFunctionArgument = 43;

    /**
     * `follow` took more hops than `maxRedirects` allows. `CURLE_TOO_MANY_REDIRECTS`.
     */
    case tooManyRedirects = 47;

    /**
     * A `set` or `raw` option the installed libcurl doesn't know. `CURLE_UNKNOWN_OPTION`.
     */
    case unknownOption = 48;

    /**
     * The server's certificate or hostname didn't check out. `caFile` is the fix for a private
     * CA. `CURLE_PEER_FAILED_VERIFICATION`.
     */
    case peerFailedVerification = 60;

    /**
     * The body passed the `maxBytes` cap. `CURLE_FILESIZE_EXCEEDED`.
     */
    case filesizeExceeded = 63;

    /**
     * Any code this enum doesn't name: a newer libcurl, or a protocol this library doesn't
     * wrap. `value()` still has the number.
     */
    case other;

    /**
     * What went wrong, in words. libcurl's sentence for the CURLcode.
     */
    public const function message() : string
    {
        return str::from(cStrerror($this->value()));
    }
}

// CURLE_OK. not an error, so not a case. `check` is the one place a raw code is read
internal const int32 CODE_OK = 0;

/**
 * A CURLcode, as Echo. The one place a raw C answer turns into `status<Error>`.
 */
internal function check(int32 $code) : status<Error>
{
    if ($code == CODE_OK) {
        return .ok;
    }

    return .error(Error::from($code));
}

#[group: "unit"]
test check_is_ok_only_for_zero {
    assert(!check(CODE_OK)->failed(), 'CURLE_OK');

    status<Error> $failed = check(28);

    assert($failed->failed() && $failed->failure() == Error::timeout, 'anything else is the error it names');
}
